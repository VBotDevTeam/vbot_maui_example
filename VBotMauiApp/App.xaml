<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:VBotMauiApp.Converters"
             x:Class="VBotMauiApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:BoolToMuteTextConverter x:Key="BoolToMuteTextConverter" />
            <converters:BoolToMuteColorConverter x:Key="BoolToMuteColorConverter" />
            <converters:BoolToSpeakerTextConverter x:Key="BoolToSpeakerTextConverter" />
            <converters:BoolToSpeakerColorConverter x:Key="BoolToSpeakerColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
