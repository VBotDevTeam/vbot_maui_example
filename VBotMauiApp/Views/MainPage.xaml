<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VBotMauiApp.ViewModels"
             x:Class="VBotMauiApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121212}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <!-- Card 1: Thông tin kết nối & Token -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    
                    <!-- Connection Status Indicator -->
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6"
                                 Color="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" />
                        <Label Text="{Binding IsConnected, Converter={StaticResource BoolToStatusTextConverter}}"
                               FontAttributes="Bold"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- User Display Name -->
                    <HorizontalStackLayout Spacing="8"
                                           IsVisible="{Binding DisplayName, Converter={StaticResource StringNotEmptyConverter}}">
                        <Label Text="Tài khoản:" FontSize="14" TextColor="Gray" VerticalOptions="Center" />
                        <Label Text="{Binding DisplayName}"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="#1E88E5"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Token Input Field -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="VBot Token (JWT)" FontSize="12" TextColor="Gray" />
                        <Editor Text="{Binding Token}"
                                AutoSize="TextChanges"
                                HeightRequest="75"
                                IsEnabled="{Binding IsConnected, Converter={StaticResource InvertBoolConverter}}"
                                Placeholder="Nhập Token VBot (hoặc dán JWT token)..." />
                    </VerticalStackLayout>

                    <!-- Loading or Action Buttons -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <!-- Connect Button -->
                    <Button Text="Kết nối"
                            Command="{Binding ConnectCommand}"
                            IsVisible="{Binding IsConnected, Converter={StaticResource InvertBoolConverter}}"
                            BackgroundColor="#1E88E5"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold" />

                    <!-- Disconnect Button -->
                    <Button Text="Ngắt kết nối"
                            Command="{Binding DisconnectCommand}"
                            IsVisible="{Binding IsConnected}"
                            BackgroundColor="Transparent"
                            BorderColor="#E53935"
                            BorderWidth="1.5"
                            TextColor="#E53935"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Card 2: Thực hiện cuộc gọi (Hiện khi đã kết nối) -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Padding="16"
                    IsVisible="{Binding IsConnected}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    
                    <Label Text="Thực hiện cuộc gọi"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <!-- Hotline Picker -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Chọn Hotline" FontSize="12" TextColor="Gray" />
                        <Picker ItemsSource="{Binding Hotlines}"
                                SelectedItem="{Binding SelectedHotline}"
                                ItemDisplayBinding="{Binding DisplayText}"
                                Title="-- Chọn Hotline --" />
                    </VerticalStackLayout>

                    <!-- Phone / Extension Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding PhoneFieldLabel}" FontSize="12" TextColor="Gray" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding PhoneNumber}"
                                   Keyboard="Telephone"
                                   Placeholder="Nhập số điện thoại hoặc mã nhánh..." />
                            <Button Grid.Column="1"
                                    Text="X"
                                    Command="{Binding ClearPhoneNumberCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="Gray"
                                    IsVisible="{Binding PhoneNumber, Converter={StaticResource StringNotEmptyConverter}}" />
                        </Grid>
                        <Label Text="{Binding PhoneHelperText}"
                               FontSize="11"
                               TextColor="#1E88E5"
                               IsVisible="{Binding IsMemberCall}" />
                    </VerticalStackLayout>

                    <!-- Call Button -->
                    <Button Text="{Binding CallButtonText}"
                            Command="{Binding CallCommand}"
                            IsEnabled="{Binding IsCalling, Converter={StaticResource InvertBoolConverter}}"
                            BackgroundColor="#43A047"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            FontSize="16" />

                </VerticalStackLayout>
            </Border>

            <!-- Card 3: Debug Log Viewer -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Padding="16"
                    IsVisible="True">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    
                    <Label Text="Debug Log"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <!-- Log Content -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#111111}"
                            Padding="8"
                            HeightRequest="300">
                        <ScrollView>
                            <Label Text="{Binding LogText}"
                                   FontSize="10"
                                   FontFamily="Courier New"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                                   LineBreakMode="WordWrap" />
                        </ScrollView>
                    </Border>

                    <!-- Log Action Buttons -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                        <Button Text="Sao chép"
                                Command="{Binding CopyLogsCommand}"
                                BackgroundColor="#1E88E5"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="36"
                                FontSize="12"
                                Padding="12,0" />
                        <Button Text="Xóa log"
                                Command="{Binding ClearLogsCommand}"
                                BackgroundColor="Transparent"
                                BorderColor="#E53935"
                                BorderWidth="1"
                                TextColor="#E53935"
                                CornerRadius="8"
                                HeightRequest="36"
                                FontSize="12"
                                Padding="12,0" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
